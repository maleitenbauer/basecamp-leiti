POSTGRES_DB=basecamp
POSTGRES_USER=basecamp
POSTGRES_PASSWORD=change-me

# First admin, created only while the user table is empty (12-72 characters). Remove it afterwards.
BASECAMP_ADMIN_USER=admin
BASECAMP_ADMIN_PASSWORD=change-me-to-something-long

# CS2 > Matches integrations (optional). Server-side secrets, never committed.
# FACEIT: developers.faceit.com -> create an app -> "Server side API key"
FACEIT_API_KEY=
# Leetify works without a key at a lower rate limit; a key from leetify.com/app/developer raises it
LEETIFY_API_KEY=

# Notifications (Web Push). Generate the pair once with: node scripts/generate-vapid-keys.mjs
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
